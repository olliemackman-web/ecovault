# Where enquiries get delivered. Set ONE of these on Vercel.
# Option A — Resend (https://resend.com): free tier, 100 emails/day
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=EcoVolt Website <enquiries@yourdomain.co.uk>
# Option B — any webhook (Zapier / Make / your CRM)
ENQUIRY_WEBHOOK_URL=
